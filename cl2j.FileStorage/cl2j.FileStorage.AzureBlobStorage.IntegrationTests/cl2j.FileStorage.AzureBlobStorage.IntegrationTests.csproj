<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscore-separated test names are intentional, they read as sentences
         in a failure report. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.17.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\cl2j.FileStorage.Provider.AzureBlobStorage\cl2j.FileStorage.Provider.AzureBlobStorage.csproj" />
    <ProjectReference Include="..\cl2j.FileStorage.Tests\cl2j.FileStorage.Tests.csproj" />
  </ItemGroup>
</Project>
