<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>cl2j.Database</PackageId>
    <Description>A fast, attribute-driven micro-ORM for SQL Server, MySQL and PostgreSQL (through the cl2j.Database.SqlServer, cl2j.Database.MySql and cl2j.Database.PostgreSql provider packages): describe a table with a plain class and get CRUD, queries by key or by example, generated string keys, JSON columns, bulk insert and table creation, all derived from the class. Dapper-level speed, no DbContext, a fraction of EF Core's memory.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cl2j.Scripting\cl2j.Scripting\cl2j.Scripting.csproj" />
    <ProjectReference Include="..\..\cl2j.Tooling\cl2j.Tooling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="cl2j.Database.Tests" />
  </ItemGroup>
</Project>
