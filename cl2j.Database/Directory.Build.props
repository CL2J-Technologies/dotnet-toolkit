<Project>

  <!-- Reprend le Directory.Build.props de la racine. Sans cet import, MSBuild s arrete au
       premier fichier trouve en remontant et les projets de ce dossier perdraient le
       TargetFramework, la licence et le reste des metadonnees communes. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- cl2j.Database et cl2j.Database.SqlServer se versionnent ensemble, toujours.
         Le provider implemente le contrat de la librairie et n a pas de sens sans elle : deux
         numeros distincts laisseraient un consommateur assembler une paire qui ne va pas
         ensemble. Le numero vit donc ici, une seule fois, et aucun des deux .csproj ne
         redefinit <Version> — ajouter un override local reintroduit exactement la derive que
         ce fichier existe pour empecher.

         3.0.0 : retrait de FormatParameterValue de IDatabaseFormatter. -->
    <Version>3.0.0</Version>
  </PropertyGroup>

</Project>
