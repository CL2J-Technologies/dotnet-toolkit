<Project>

  <!-- Picks up the Directory.Build.props at the repository root. Without this import MSBuild
       stops at the first file it finds walking up, and the projects in this folder would lose
       the TargetFramework, the license and the rest of the shared metadata. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- cl2j.Database and cl2j.Database.SqlServer version together, always.
         The provider implements the library's contract and is meaningless without it: two
         separate numbers would let a consumer assemble a pair that does not belong together.
         The number therefore lives here, once, and neither .csproj redefines <Version> —
         adding a local override reintroduces exactly the drift this file exists to prevent.

         3.0.0: FormatParameterValue removed from IDatabaseFormatter. -->
    <Version>3.0.0</Version>
  </PropertyGroup>

</Project>
