<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscore-separated test names are intentional, they read as sentences
         in the CI report. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The Mx* entities, one per mapped type, are shared with the integration tests so that both
         prove the same types. -->
    <Compile Include="..\cl2j.Database.IntegrationTests.Shared\TypeMatrixEntities.cs" Link="TypeMatrixEntities.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\cl2j.Database\cl2j.Database.csproj" />
    <ProjectReference Include="..\cl2j.Database.SqlServer\cl2j.Database.SqlServer.csproj" />
  </ItemGroup>

</Project>
