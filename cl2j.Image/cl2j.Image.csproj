<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>cl2j.Image</PackageId>
    <Description>Image utilities: EXIF data extraction, image comparison, and resizing. Cross-platform, on ImageSharp.</Description>

    <!-- 3.0.0: breaking change, the public surface moves from System.Drawing.Bitmap to
         SixLabors.ImageSharp.Image<Rgba32>. The number is overridden here rather than in
         Directory.Build.props, which carries the version shared by every package in the
         repository. Without it, publishing would be skipped by the workflow skip-duplicate
         option: 2.0.0 already exists on nuget.org, and the fix would never reach the feed. -->
    <Version>3.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Drawing.Common removed on September 3rd 2026. It throws
         PlatformNotSupportedException off Windows since .NET 6, which left this library mute and
         inoperative on Linux. Do not reintroduce it. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\cl2j.FileStorage\cl2j.FileStorage\cl2j.FileStorage.csproj" />
    <ProjectReference Include="..\cl2j.Tooling\cl2j.Tooling.csproj" />
  </ItemGroup>
</Project>
